{
  "name": "streamv2",
  "productName": "StreamV2",
  "version": "1.16.0",
  "description": "Alertas de regalos, rankings y bot de voz para TikTok LIVE",
  "author": "alucardmex",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.streamv2.app",
    "productName": "StreamV2",
    "copyright": "StreamV2",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "public/**",
      "server.js",
      "tts.js",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "StreamV2-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "StreamV2",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "StreamV2"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alucardmex",
        "repo": "streamv2",
        "releaseType": "release"
      }
    ]
  }
}
